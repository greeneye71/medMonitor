# Creato e aggiornato da install.sh: normalmente non serve modificarlo a mano.
# Formato env-file di Podman: niente virgolette, niente commenti sulla stessa riga.

# Porta della UI web (mai 8000)
UI_PORT=8090
# IP statico del SONOFF Dongle-M (porta TCP 6638)
GATEWAY_IP=192.168.1.50
# Usata solo al primo avvio; poi si cambia dalla UI (Impostazioni > Sicurezza)
ADMIN_PASSWORD=admin
# Chiave dei cookie di sessione, generata da install.sh
SECRET_KEY=cambiami
TZ=Europe/Rome
